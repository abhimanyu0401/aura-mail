# Copy this file to .env.local and fill in your keys
# Gemini API Key (Required for AI detection)
GEMINI_API_KEY=your_gemini_key_here

# Google Safe Browsing API Key (Optional)
SAFE_BROWSING_API_KEY=your_safe_browsing_key_here

# Supabase Credentials (Required for auth & circles)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

REDIS_KV_REST_API_URL=your_upstash_redis_rest_url
REDIS_KV_REST_API_TOKEN=your_upstash_redis_rest_token
